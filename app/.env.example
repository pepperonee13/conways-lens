# Copy to `.env` (or `.env.local`) and adjust as needed.
# All vars are read at build time via Vite's `import.meta.env`.
# Parsing lives in `src/config.js`.

# Replace real author names with stable pseudonyms in the UI.
# Display-only — store data and JSON export keep real names.
# Accepts: true | false | 1 | 0  (default: false)
VITE_ANONYMIZE_AUTHORS=false

# Default value for the "Violation threshold" slider, in percent.
# Min outside-team contribution share to flag a repo as violating.
# Range: 0–100  (default: 10)
VITE_MIN_VIOLATION_PCT=10

# Default state of the "Display authors" toggle in the visualization panel.
# When on, repo and team-pill tooltips list contributing authors.
# Accepts: true | false | 1 | 0  (default: true)
VITE_DISPLAY_AUTHORS_DEFAULT=true
